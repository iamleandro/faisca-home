---
/** Footer — design-kit/components/footer.html, markup verbatim. */
import { Image } from "astro:assets";
import mark from "../assets/faisca-mark-120.png";
import SocialLinks from "./SocialLinks.astro";
import { FOOTER_COLS, SITE } from "../data/site";
---

<footer class="site-footer">
  <div class="site-footer__top">
    <div class="site-footer__brand">
      <div class="site-footer__mark">
        <Image src={mark} alt={SITE.name} width={40} height={40} loading="lazy" />
        <span class="site-footer__wordmark">{SITE.wordmark}</span>
      </div>
      <p class="site-footer__tagline">{SITE.tagline}</p>
      <a class="site-footer__mail" href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </div>
    {
      FOOTER_COLS.map((col) => (
        <nav class="site-footer__col" aria-label={col.heading}>
          <div class="site-footer__head">{col.heading}</div>
          {col.links.map((l) => (
            <a class="site-footer__link" href={l.href}>
              {l.label}
            </a>
          ))}
        </nav>
      ))
    }
  </div>
  <div class="site-footer__bar">
    <div class="site-footer__legal">{SITE.legal}</div>
    <SocialLinks />
  </div>
</footer>
